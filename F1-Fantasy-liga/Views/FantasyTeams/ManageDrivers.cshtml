@model F1_Fantasy_liga.Models.ManageFantasyTeamDriversViewModel

@{
    ViewData["Title"] = "Manage Drivers";
    var selectedIds = string.Join(",", Model.SelectedDrivers.Select(d => d.Id));
}

<form asp-action="ManageDrivers"
      asp-route-id="@Model.TeamId"
      method="post"
      class="build-team-page manage-drivers-page"
      data-budget-limit="@Model.BudgetLimit.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    @Html.AntiForgeryToken()

    <header class="build-team-header card-shell">
        <h1>Manage drivers for @Model.TeamName</h1>
        <div class="budget-row">
            <div class="budget-item">
                <span class="budget-label">Budget limit</span>
                <strong id="budgetLimit">@Model.BudgetLimit.ToString("0.0") M</strong>
            </div>
            <div class="budget-item">
                <span class="budget-label">Used budget</span>
                <strong id="usedBudget">0.0 M</strong>
            </div>
            <div class="budget-item">
                <span class="budget-label">Remaining budget</span>
                <strong id="remainingBudget">0.0 M</strong>
            </div>
            <div class="budget-item">
                <span class="budget-label">Drivers selected</span>
                <strong id="driverCount">0</strong>
            </div>
        </div>
        <div class="budget-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div id="budgetProgressBar" class="budget-progress-bar"></div>
        </div>
        <div class="form-actions" style="margin-top: 16px;">
            <button type="submit" class="details-btn">Save drivers</button>
            <a class="details-btn secondary" asp-action="Edit" asp-route-id="@Model.TeamId">Back to edit</a>
        </div>
    </header>

    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <input type="hidden" id="selectedDriverIds" name="driverIds" value="@selectedIds" />

    <div class="build-team-grid">
        <section class="drivers-market card-shell">
            <h2>Available drivers</h2>
            <div class="driver-list" id="driverMarketList">
                @foreach (var driver in Model.AvailableDrivers)
                {
                    <article class="driver-card"
                             data-driver-id="@driver.Id"
                             data-driver-name="@driver.Name @driver.Surname"
                             data-constructor="@driver.Constructor?.Name"
                             data-price="@driver.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <div class="driver-card-main">
                            <h3>@driver.Name @driver.Surname</h3>
                            <p>@driver.Constructor?.Name</p>
                            <strong>@driver.Price.ToString("0.0") M</strong>
                        </div>
                        <button type="button" class="driver-action-btn add-driver-btn">Add</button>
                    </article>
                }
            </div>
        </section>

        <section class="selected-team card-shell">
            <h2>Selected drivers</h2>
            <p class="team-hint" id="emptyTeamHint">No drivers selected yet.</p>
            <div id="selectedTeamList" class="driver-list selected-list">
                @foreach (var driver in Model.SelectedDrivers)
                {
                    <article class="driver-card"
                             data-driver-id="@driver.Id"
                             data-driver-name="@driver.Name @driver.Surname"
                             data-constructor="@driver.Constructor?.Name"
                             data-price="@driver.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <div class="driver-card-main">
                            <h3>@driver.Name @driver.Surname</h3>
                            <p>@driver.Constructor?.Name</p>
                            <strong>@driver.Price.ToString("0.0") M</strong>
                        </div>
                        <button type="button" class="driver-action-btn remove-driver-btn">Remove</button>
                    </article>
                }
            </div>
        </section>
    </div>
</form>

@section Scripts {
    <script src="~/js/manage-team.js" asp-append-version="true"></script>
}
