@model F1_Fantasy_liga.Models.Constructor

@{
    ViewData["Title"] = "New Constructor";
    var foundedDateValue = Model.FoundedDate?.ToString("yyyy-MM-dd") ?? string.Empty;
}

<h1>New Constructor</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">
    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <div class="form-row">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Nationality" class="form-label"></label>
        <input asp-for="Nationality" class="form-input" />
        <span asp-validation-for="Nationality" class="form-error"></span>
    </div>

    <div class="form-row">
        <label for="imageFile" class="form-label">Image</label>
        <input type="file" id="imageFile" name="imageFile" class="form-input" accept="image/*" />
    </div>

    @await Html.PartialAsync("_DatePicker", new DatePickerViewModel
    {
        Label = "Founded date",
        InputName = nameof(Model.FoundedDate),
        InputId = "founded-date",
        DateValue = foundedDateValue,
        ShowTime = false
    })

    <div class="form-actions">
        <button type="submit" class="details-btn">Create</button>
        <a class="details-btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        this.element(element);
                    }
                });
            }
        });
    </script>
}
