@model F1_Fantasy_liga.Models.Constructor

@{
    ViewData["Title"] = "Edit Constructor";
}

<h1>Edit Constructor</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <input asp-for="Id" type="hidden" />

    <div class="form-row">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Nationality" class="form-label"></label>
        <input asp-for="Nationality" class="form-input" />
        <span asp-validation-for="Nationality" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="FoundedDate" class="form-label"></label>
        <input asp-for="FoundedDate" class="form-input" type="date" />
        <span asp-validation-for="FoundedDate" class="form-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="details-btn">Save changes</button>
        <a class="details-btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        this.element(element);
                    }
                });
            }
        });
    </script>
}
