@model F1_Fantasy_liga.Models.Race

@{
    ViewData["Title"] = "Edit Race";
}

<h1>Edit Race</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <input asp-for="Id" type="hidden" />

    <div class="form-row">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="RaceDate" class="form-label"></label>
        <input asp-for="RaceDate" class="form-input" type="datetime-local" />
        <span asp-validation-for="RaceDate" class="form-error"></span>
    </div>

    @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteFieldViewModel
    {
        Label = "Circuit",
        HiddenInputName = nameof(Model.CircuitId),
        HiddenInputId = "circuit-id",
        DisplayInputId = "circuit-name",
        SearchUrl = Url.Action("Autocomplete", "Circuits") ?? string.Empty,
        Placeholder = "Search circuits...",
        SelectedId = Model.CircuitId,
        SelectedText = ViewBag.CircuitName as string ?? Model.Circuit?.Name ?? string.Empty
    })

    <div class="form-actions">
        <button type="submit" class="details-btn">Save changes</button>
        <a class="details-btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        this.element(element);
                    }
                });
            }
        });
    </script>
}
