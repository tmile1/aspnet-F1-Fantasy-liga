@model F1_Fantasy_liga.Models.FantasyLeague

@{
    ViewData["Title"] = "Edit Fantasy League";
    var startDateValue = Model.StartDate == default ? string.Empty : Model.StartDate.ToString("yyyy-MM-dd");
    var startTimeValue = Model.StartDate == default ? string.Empty : Model.StartDate.ToString("HH:mm");
    var endDateValue = Model.EndDate == default ? string.Empty : Model.EndDate.ToString("yyyy-MM-dd");
    var endTimeValue = Model.EndDate == default ? string.Empty : Model.EndDate.ToString("HH:mm");
}

<h1>Edit Fantasy League</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <input asp-for="Id" type="hidden" />

    <div class="form-row">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-input" rows="3"></textarea>
        <span asp-validation-for="Description" class="form-error"></span>
    </div>

    @await Html.PartialAsync("_DatePicker", new DatePickerViewModel
    {
        Label = "Start date",
        InputName = nameof(Model.StartDate),
        InputId = "start-date",
        DateValue = startDateValue,
        TimeValue = startTimeValue,
        ShowTime = true
    })

    @await Html.PartialAsync("_DatePicker", new DatePickerViewModel
    {
        Label = "End date",
        InputName = nameof(Model.EndDate),
        InputId = "end-date",
        DateValue = endDateValue,
        TimeValue = endTimeValue,
        ShowTime = true
    })

    <div class="form-row">
        <label asp-for="LeagueType" class="form-label">League type</label>
        <select asp-for="LeagueType" asp-items="ViewBag.LeagueTypes" class="form-input"></select>
        <span asp-validation-for="LeagueType" class="form-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="details-btn">Save changes</button>
        <a class="details-btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        this.element(element);
                    }
                });
            }
        });
    </script>
}
