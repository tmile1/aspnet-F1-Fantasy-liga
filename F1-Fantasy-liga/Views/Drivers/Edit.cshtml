@model F1_Fantasy_liga.Models.Driver

@{
    ViewData["Title"] = "Edit Driver";
}

<h1>Edit Driver</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <input asp-for="Id" type="hidden" />

    <div class="form-row">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Surname" class="form-label"></label>
        <input asp-for="Surname" class="form-input" />
        <span asp-validation-for="Surname" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Number" class="form-label"></label>
        <input asp-for="Number" class="form-input" type="number" step="1" min="1" max="99" />
        <span asp-validation-for="Number" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-input" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="form-error"></span>
    </div>

    @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteFieldViewModel
    {
        Label = "Constructor",
        HiddenInputName = nameof(Model.ConstructorId),
        HiddenInputId = "constructor-id",
        DisplayInputId = "constructor-name",
        SearchUrl = Url.Action("Autocomplete", "Constructors") ?? string.Empty,
        Placeholder = "Search constructors...",
        SelectedId = Model.ConstructorId,
        SelectedText = ViewBag.ConstructorName as string ?? Model.Constructor?.Name ?? string.Empty
    })

    <div class="form-actions">
        <button type="submit" class="details-btn">Save changes</button>
        <a class="details-btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        this.element(element);
                    }
                });
            }
        });
    </script>
}
