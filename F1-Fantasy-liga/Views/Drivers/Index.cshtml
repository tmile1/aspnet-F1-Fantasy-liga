@model IEnumerable<F1_Fantasy_liga.Models.Driver>

<div class="page-header">
    <h1>Drivers</h1>
    <a class="details-btn" asp-action="Create">New drivers</a>
</div>

<form method="get" asp-action="Index" class="search-row" data-search-url="@Url.Action("Search")">
    <input type="text"
           id="drivers-search-input"
           name="q"
           class="search-input"
           placeholder="Search drivers..." />
    <button type="submit" class="details-btn">Search</button>
    <a asp-action="Index" class="back-btn">Clear</a>
</form>

<div class="card-grid" id="drivers-results">
    @await Html.PartialAsync("_DriversCards", Model)
</div>

<div class="modal-backdrop" id="delete-modal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
        <h2 class="modal-title" id="delete-modal-title">Delete driver</h2>
        <p class="modal-text">Are you sure you want to delete <span id="delete-entity-name"></span>?</p>
        <form method="post" id="delete-form">
            @Html.AntiForgeryToken()
            <div class="modal-actions">
                <button type="submit" class="details-btn danger">Yes</button>
                <button type="button" class="details-btn secondary" data-modal-close>No</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const searchInput = document.getElementById("drivers-search-input");
            const results = document.getElementById("drivers-results");
            const searchForm = document.querySelector(".search-row");
            if (!searchInput || !results || !searchForm) {
                return;
            }

            let debounceTimer;
            const searchUrl = searchForm.getAttribute("data-search-url");

            const runSearch = () => {
                const term = searchInput.value.trim();
                const url = `${searchUrl}?term=${encodeURIComponent(term)}`;
                fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then((response) => response.text())
                    .then((html) => {
                        results.innerHTML = html;
                    });
            };

            searchInput.addEventListener("input", () => {
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(runSearch, 250);
            });
        });
    </script>
}