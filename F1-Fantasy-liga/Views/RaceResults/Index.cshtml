@model IEnumerable<F1_Fantasy_liga.Models.RaceResult>

<div class="page-header">
    <h1>Race Results</h1>
    <a class="details-btn" asp-action="Create">New race result</a>
</div>

<form method="get" asp-action="Index" class="search-row" data-search-url="@Url.Action("Search")">
    <input type="text"
           id="race-search-input"
           name="raceSearch"
           value="@ViewData["RaceSearch"]"
           class="search-input"
           placeholder="Search by race name..." />
    <button type="submit" class="details-btn">Search</button>
    <a asp-action="Index" class="back-btn">Clear</a>
</form>

<table border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th>Id</th>
            <th>Race</th>
            <th>Driver</th>
            <th>Position</th>
            <th>Points</th>
            <th>Details</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody id="race-results-body">
        @await Html.PartialAsync("_RaceResultsTableBody", Model)
    </tbody>
</table>

<div class="modal-backdrop" id="delete-modal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
        <h2 class="modal-title" id="delete-modal-title">Delete race result</h2>
        <p class="modal-text">Are you sure you want to delete <span id="delete-entity-name"></span>?</p>
        <form method="post" id="delete-form">
            @Html.AntiForgeryToken()
            <div class="modal-actions">
                <button type="submit" class="details-btn danger">Yes</button>
                <button type="button" class="details-btn secondary" data-modal-close>No</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const searchInput = document.getElementById("race-search-input");
            const resultsBody = document.getElementById("race-results-body");
            const searchForm = document.querySelector(".search-row");
            if (!searchInput || !resultsBody || !searchForm) {
                return;
            }

            let debounceTimer;
            const searchUrl = searchForm.getAttribute("data-search-url");

            const runSearch = () => {
                const term = searchInput.value.trim();
                const url = `${searchUrl}?term=${encodeURIComponent(term)}`;
                fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then((response) => response.text())
                    .then((html) => {
                        resultsBody.innerHTML = html;
                    });
            };

            searchInput.addEventListener("input", () => {
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(runSearch, 250);
            });
        });
    </script>
}