@model F1_Fantasy_liga.Models.RaceResult

@{
    ViewData["Title"] = "Edit Race Result";
}

<h1>Edit Race Result</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <div class="validation-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    <input asp-for="Id" type="hidden" />

    @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteFieldViewModel
    {
        Label = "Race",
        HiddenInputName = nameof(Model.RaceId),
        HiddenInputId = "race-id",
        DisplayInputId = "race-name",
        SearchUrl = Url.Action("Autocomplete", "Races") ?? string.Empty,
        Placeholder = "Search races...",
        SelectedId = Model.RaceId,
        SelectedText = ViewBag.RaceName as string ?? Model.Race?.Name ?? string.Empty
    })

    @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteFieldViewModel
    {
        Label = "Driver",
        HiddenInputName = nameof(Model.DriverId),
        HiddenInputId = "driver-id",
        DisplayInputId = "driver-name",
        SearchUrl = Url.Action("Autocomplete", "Drivers") ?? string.Empty,
        Placeholder = "Search drivers...",
        SelectedId = Model.DriverId,
        SelectedText = ViewBag.DriverName as string ?? (Model.Driver != null ? Model.Driver.Name + " " + Model.Driver.Surname : string.Empty)
    })

    <div class="form-row">
        <label asp-for="FinishedPosition" class="form-label"></label>
        <input asp-for="FinishedPosition" class="form-input" type="number" step="1" min="1" max="25" />
        <span asp-validation-for="FinishedPosition" class="form-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="DriverStatus" class="form-label">Driver status</label>
        <select asp-for="DriverStatus" asp-items="ViewBag.DriverStatuses" class="form-input"></select>
        <span asp-validation-for="DriverStatus" class="form-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="details-btn">Save changes</button>
        <a class="details-btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        this.element(element);
                    }
                });
            }
        });
    </script>
}
